<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Athlete Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Athlete Name"
            app:boxStrokeColor="#000000"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="#000000"
            app:boxBackgroundColor="#FFFFFF"
            app:errorTextColor="#FF0000"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAthleteName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#000000"
                android:textSize="16sp"
                android:padding="12dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Incident Type -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Incident Type"
            app:boxStrokeColor="#000000"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="#000000"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp">

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerIncidentType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#000000"
                android:padding="12dp"
                android:popupBackground="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Severity -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Severity"
            app:boxStrokeColor="#000000"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="#000000"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp">

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerSeverity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#000000"
                android:padding="12dp"
                android:popupBackground="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Incident Description"
            app:boxStrokeColor="#000000"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="#000000"
            app:boxBackgroundColor="#FFFFFF"
            app:errorTextColor="#FF0000"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:textColor="#000000"
                android:textSize="16sp"
                android:padding="12dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Immediate Action -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="Immediate Action Taken (Optional)"
            app:boxStrokeColor="#000000"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="#000000"
            app:boxBackgroundColor="#FFFFFF"
            app:errorTextColor="#FF0000"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etImmediateAction"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:textColor="#000000"
                android:textSize="16sp"
                android:padding="12dp" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>