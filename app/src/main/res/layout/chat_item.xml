<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- BOT MESSAGE (LEFT) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/left_chat_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="80dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeColor="#E53935"
        app:strokeWidth="1dp"
        android:maxWidth="280dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/bot_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_robot"
                app:tint="#E53935"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/left_chat_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/roboto"
                android:lineSpacingExtra="4sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- USER MESSAGE (RIGHT) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/right_chat_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="80dp"
        app:cardBackgroundColor="#E53935"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        android:maxWidth="280dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:padding="14dp">

            <TextView
                android:id="@+id/right_chat_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/roboto"
                android:layout_marginEnd="10dp"
                android:lineSpacingExtra="4sp" />

            <ImageView
                android:id="@+id/user_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/avatarchat"
                android:layout_gravity="center_vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>